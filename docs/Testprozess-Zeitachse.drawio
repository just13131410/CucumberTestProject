<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="zeitachse" name="Zeitachse Sprint-Zyklus">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titel -->
        <mxCell id="title" value="Testprozess: Zeitachse eines Sprint-Zyklus (Sprintdauer 3 Wochen)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1b2328;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="900" height="36" as="geometry" />
        </mxCell>

        <!-- Sprints -->
        <mxCell id="h-sprint-n" value="Sprint N" style="rounded=0;html=1;fillColor=#e3e9ec;strokeColor=none;fontColor=#1b2328;fontStyle=1;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="64" width="479" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h-sprint-n1" value="Sprint N+1" style="rounded=0;html=1;fillColor=#eef2f4;strokeColor=none;fontColor=#1b2328;fontStyle=1;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="661" y="64" width="479" height="30" as="geometry" />
        </mxCell>

        <!-- Wochen -->
        <mxCell id="w1" value="Woche 1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#5a6870;" vertex="1" parent="1">
          <mxGeometry x="180" y="96" width="160" height="22" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="Woche 2" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#5a6870;" vertex="1" parent="1">
          <mxGeometry x="340" y="96" width="160" height="22" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="Woche 3" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#5a6870;" vertex="1" parent="1">
          <mxGeometry x="500" y="96" width="160" height="22" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="Woche 1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#5a6870;" vertex="1" parent="1">
          <mxGeometry x="660" y="96" width="160" height="22" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="Woche 2" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#5a6870;" vertex="1" parent="1">
          <mxGeometry x="820" y="96" width="160" height="22" as="geometry" />
        </mxCell>
        <mxCell id="w6" value="Woche 3" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#5a6870;" vertex="1" parent="1">
          <mxGeometry x="980" y="96" width="160" height="22" as="geometry" />
        </mxCell>

        <!-- Wochengrenzen -->
        <mxCell id="g-w2" style="endArrow=none;html=1;dashed=1;dashPattern=2 4;strokeColor=#d0d8dd;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="340" y="96" as="sourcePoint" /><mxPoint x="340" y="364" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="g-w3" style="endArrow=none;html=1;dashed=1;dashPattern=2 4;strokeColor=#d0d8dd;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="96" as="sourcePoint" /><mxPoint x="500" y="364" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="g-w5" style="endArrow=none;html=1;dashed=1;dashPattern=2 4;strokeColor=#d0d8dd;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="820" y="96" as="sourcePoint" /><mxPoint x="820" y="364" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="g-w6" style="endArrow=none;html=1;dashed=1;dashPattern=2 4;strokeColor=#d0d8dd;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="980" y="96" as="sourcePoint" /><mxPoint x="980" y="364" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Sprintende -->
        <mxCell id="g-sprintende" style="endArrow=none;html=1;strokeColor=#5a6870;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="660" y="64" as="sourcePoint" /><mxPoint x="660" y="374" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l-sprintende" value="Sprintende N / Start N+1" style="rounded=1;arcSize=30;html=1;fillColor=#5a6870;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="374" width="160" height="24" as="geometry" />
        </mxCell>

        <!-- Zeilenbeschriftungen -->
        <mxCell id="l-dev" value="dev" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#3d6fb6;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l-test" value="test" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0f8a6d;" vertex="1" parent="1">
          <mxGeometry x="40" y="196" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l-abn" value="Abnahme" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#b7791f;" vertex="1" parent="1">
          <mxGeometry x="40" y="252" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l-prod" value="Prod" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#a63d50;" vertex="1" parent="1">
          <mxGeometry x="40" y="308" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- dev -->
        <mxCell id="b-dev" value="3× täglich automatisiert, durchgehend" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e3ecf8;strokeColor=#3d6fb6;strokeWidth=1.5;fontColor=#1b2328;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="184" y="140" width="952" height="40" as="geometry" />
        </mxCell>

        <!-- test -->
        <mxCell id="b-test-n" value="je Anpassung: automatisiert + manuell" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcf1eb;strokeColor=#0f8a6d;strokeWidth=1.5;fontColor=#1b2328;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="184" y="196" width="470" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-test-n1" value="je Anpassung, Stand Sprint N+1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcf1eb;strokeColor=#0f8a6d;strokeWidth=1.5;fontColor=#1b2328;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="666" y="196" width="470" height="40" as="geometry" />
        </mxCell>

        <!-- Abnahme: Release schnüren am Sprintende, dann eine Woche Abnahme -->
        <mxCell id="t-rel" value="Release schnüren" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1b2328;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="258" width="164" height="28" as="geometry" />
        </mxCell>
        <mxCell id="m-rel" value="" style="rhombus;html=1;fillColor=#b7791f;strokeColor=#ffffff;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="647" y="259" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b-abn" value="Abnahme: 1 Woche" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6ead6;strokeColor=#b7791f;strokeWidth=1.5;fontColor=#1b2328;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="678" y="252" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- Prod: Meilenstein nach der Abnahme -->
        <mxCell id="m-prod" value="" style="rhombus;html=1;fillColor=#a63d50;strokeColor=#ffffff;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="827" y="315" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="t-prod" value="Release auf Prod" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1b2328;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="856" y="314" width="180" height="28" as="geometry" />
        </mxCell>

        <!-- Übergänge -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b7791f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="m-rel" target="b-abn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#a63d50;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="b-abn" target="m-prod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Hinweis -->
        <mxCell id="note" value="Am Sprintende wird der Release geschnürt und auf Abnahme installiert. Die Abnahmewoche von Sprint N ist zugleich die erste Woche von Sprint N+1: dev und test laufen dann bereits mit dem neuen Stand." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#5a6870;" vertex="1" parent="1">
          <mxGeometry x="180" y="410" width="960" height="36" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
