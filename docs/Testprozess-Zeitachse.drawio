<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="zeitachse" name="Zeitachse Sprint-Zyklus">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titel -->
        <mxCell id="title" value="Testprozess: Zeitachse eines Sprint-Zyklus" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1b2328;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="700" height="36" as="geometry" />
        </mxCell>

        <!-- Phasen (Spaltenköpfe) -->
        <mxCell id="h-sprint" value="Sprint" style="rounded=0;html=1;fillColor=#eef2f4;strokeColor=none;fontColor=#5a6870;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="170" y="70" width="358" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h-ende" value="Sprintende" style="rounded=0;html=1;fillColor=#eef2f4;strokeColor=none;fontColor=#5a6870;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="70" width="178" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h-abn" value="Abnahmewoche" style="rounded=0;html=1;fillColor=#eef2f4;strokeColor=none;fontColor=#5a6870;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="710" y="70" width="178" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h-danach" value="danach" style="rounded=0;html=1;fillColor=#eef2f4;strokeColor=none;fontColor=#5a6870;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="70" width="180" height="30" as="geometry" />
        </mxCell>

        <!-- Phasengrenzen -->
        <mxCell id="g1" style="endArrow=none;html=1;dashed=1;strokeColor=#c3ccd2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="529" y="100" as="sourcePoint" /><mxPoint x="529" y="390" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="g2" style="endArrow=none;html=1;dashed=1;strokeColor=#c3ccd2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="709" y="100" as="sourcePoint" /><mxPoint x="709" y="390" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="g3" style="endArrow=none;html=1;dashed=1;strokeColor=#c3ccd2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="889" y="100" as="sourcePoint" /><mxPoint x="889" y="390" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Zeilenbeschriftungen -->
        <mxCell id="l-dev" value="dev" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#3d6fb6;" vertex="1" parent="1">
          <mxGeometry x="40" y="114" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l-test" value="test" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0f8a6d;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l-rel" value="Release" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#b7791f;" vertex="1" parent="1">
          <mxGeometry x="40" y="226" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l-abn" value="Abnahme" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#b7791f;" vertex="1" parent="1">
          <mxGeometry x="40" y="282" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l-prod" value="Prod" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#a63d50;" vertex="1" parent="1">
          <mxGeometry x="40" y="338" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Balken -->
        <mxCell id="b-dev" value="3× täglich automatisiert, durchgehend" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e3ecf8;strokeColor=#3d6fb6;strokeWidth=1.5;fontColor=#1b2328;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="174" y="114" width="892" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-test" value="je Anpassung: automatisiert + manuell" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dcf1eb;strokeColor=#0f8a6d;strokeWidth=1.5;fontColor=#1b2328;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="174" y="170" width="350" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-test-next" value="nächster Sprint: je Anpassung" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f2f9f6;strokeColor=#0f8a6d;strokeWidth=1.5;dashed=1;fontColor=#5a6870;fontStyle=2;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="714" y="170" width="352" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-rel" value="Release schnüren" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6ead6;strokeColor=#b7791f;strokeWidth=1.5;fontColor=#1b2328;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="534" y="226" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-abn" value="1 Woche" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f6ead6;strokeColor=#b7791f;strokeWidth=1.5;fontColor=#1b2328;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="714" y="282" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-prod" value="Release" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f3dfe3;strokeColor=#a63d50;strokeWidth=1.5;fontColor=#1b2328;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="894" y="338" width="172" height="40" as="geometry" />
        </mxCell>

        <!-- Übergänge -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b7791f;" edge="1" parent="1" source="b-rel" target="b-abn">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="619" y="302" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#a63d50;" edge="1" parent="1" source="b-abn" target="b-prod">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="799" y="358" /></Array></mxGeometry>
        </mxCell>

        <!-- Hinweis -->
        <mxCell id="note" value="Der nächste Sprint beginnt parallel zur Abnahmewoche. dev und test laufen dann bereits mit dem neuen Stand weiter." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#5a6870;" vertex="1" parent="1">
          <mxGeometry x="170" y="398" width="900" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
